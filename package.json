{
	"name": "retro-tens",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"sync": "svelte-kit sync",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint:js": "eslint .",
		"lint:css": "stylelint \"src/**/*.{css,svelte}\"",
		"lint:biome": "biome lint .",
		"lint": "bun run lint:js && bun run lint:css && bun run lint:biome",
		"format:check": "biome format .",
		"format": "biome format --write .",
		"fix:js": "eslint . --fix",
		"fix": "bun run format && bun run fix:js",
		"check": "bun run typecheck && bun run lint && bun run format:check"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.1",
		"@biomejs/biome": "^2.4.11",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.8",
		"@types/node": "^24",
		"eslint": "^10.2.0",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"postcss-html": "^1.8.1",
		"stylelint": "^17.6.0",
		"stylelint-config-standard": "^40.0.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@ark-ui/svelte": "^5.21.0",
		"@faker-js/faker": "^10.4.0",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"layerchart": "^1.0.13",
		"lucide-svelte": "^1.0.1"
	}
}
