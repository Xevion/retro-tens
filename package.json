{
	"name": "retro-tens",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:a11y": "playwright test",
		"prepare": "(svelte-kit sync || echo '') && panda codegen",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint:js": "eslint .",
		"lint:biome": "biome lint .",
		"lint:actions": "actionlint",
		"format": "biome format .",
		"spell": "typos",
		"analyze": "fallow --group-by directory",
		"analyze:production": "fallow dead-code --production --quiet --group-by directory",
		"analyze:audit": "fallow audit --changed-since origin/master",
		"fix:dead": "fallow fix --dry-run",
		"fix:dead:apply": "fallow fix --yes",
		"links": "lychee --offline docs README.md",
		"audit": "bun audit --prod --audit-level moderate; exit 0",
		"just:check": "just --fmt --check --unstable",
		"lighthouse": "unlighthouse",
		"check": "bun run typecheck && bun run lint:js && bun run lint:biome && bun run lint:actions && bun run format && bun run spell && bun run analyze && bun run analyze:production && bun run links && bun run audit && bun run just:check",
		"fix": "biome format --write . && eslint . --fix",
		"icons:generate": "bun scripts/generate-icons.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.1",
		"@biomejs/biome": "^2.5.10",
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@pandacss/dev": "^1.9.1",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/d3-array": "^3.2.2",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.8",
		"@types/node": "^24",
		"eslint": "^10.2.0",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"unlighthouse": "^0.17.7",
		"vite": "^8.0.7",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"picomatch": "4.0.4"
	},
	"dependencies": {
		"@ark-ui/svelte": "^5.21.0",
		"@faker-js/faker": "^10.4.0",
		"d3-array": "^3.2.4",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"lucide-svelte": "^1.0.1"
	}
}
